{
  "name": "aram-augment-advisor",
  "version": "0.2.7",
  "description": "海克斯大乱斗强化符文助手",
  "author": "488668747",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test",
    "data:import": "node scripts/import-data.mjs",
    "data:sync": "node scripts/sync-global-data.mjs",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "verify:overlay": "electron scripts/verify-overlay.cjs",
    "verify:lcu": "electron scripts/verify-lcu.cjs",
    "start": "electron .",
    "predist:dir": "npm run ocr:prepare",
    "dist:dir": "electron-builder --dir",
    "predist:win": "npm run ocr:prepare",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aramaugmentadvisor.desktop",
    "productName": "海克斯大乱斗助手",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/runtime",
        "to": "data/runtime"
      },
      {
        "from": "resources/ocr",
        "to": "ocr",
        "filter": [
          "**/*",
          "!**/*.test.js",
          "!tests/**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "aram-augment-advisor-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "tesseract.js": "6.0.1"
  }
}
